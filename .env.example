# ============================================
# phillyrentallicense.co — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# ============================================
# Supabase (shared with HubKey admin backend)
# ============================================
# From: https://supabase.com/dashboard → Project Settings → API
# Writes to rental_license_applications + landing_page_leads tables
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# Stripe (shared HubKey account — test mode locally)
# ============================================
# Test keys (sk_test_ / pk_test_) are fine for dev; flip to live at launch
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================
# Email (Resend — for payment + onboarding confirmations)
# ============================================
RESEND_API_KEY=

# ============================================
# Slack (team notifications on each paid application)
# ============================================
SLACK_WEBHOOK_URL=

# ============================================
# Google Drive (auto-create client folder on payment)
# ============================================
# Optional — if unset, Drive folder creation is skipped silently
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_DRIVE_RENTAL_LICENSE_FOLDER_ID=

# ============================================
# Analytics (PostHog + GA4)
# ============================================
# PostHog is optional — landing works without; events no-op
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# GA4 only needed if running Google Ads traffic
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ============================================
# URLs (set in production Vercel env)
# ============================================
# Where the admin dashboard lives for deep-links in email/Slack
NEXT_PUBLIC_APP_URL=https://hubkey-hub.vercel.app
# Primary public URL for intake/checkout redirects. Leave blank locally
# to fall back to window.location.origin.
NEXT_PUBLIC_APPLY_URL=

# ============================================
# Admin dashboard (/admin/progress)
# ============================================
# Any passphrase — required to access /admin/progress. Cookie lasts 14 days.
ADMIN_PASSWORD=

# ============================================
# Philadelphia City APIs
# ============================================
# NO KEYS NEEDED — free public APIs:
#   CARTO SQL:  https://phl.carto.com/api/v2/sql
#   ArcGIS:     https://services.arcgis.com/fLeGjb7u4uXqeF9q/arcgis/rest/services/
